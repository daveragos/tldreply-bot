# Telegram Bot Configuration
TELEGRAM_TOKEN=your_bot_token_here

# Database Configuration
# PostgreSQL connection string
# Examples:
# - Railway: postgresql://postgres:password@host:port/railway
# - Supabase: postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true&connect_timeout=15
# - Local: postgresql://postgres:password@localhost:5432/tldr_bot
DATABASE_URL=postgresql://user:password@host:port/database

# Encryption Secret (for encrypting API keys)
# Generate a random 32+ character string
# You can use: openssl rand -hex 32
ENCRYPTION_SECRET=your_random_secret_key_min_32_characters

# Node Environment
NODE_ENV=production

# --- Retention & free-tier tuning (all optional) ---
# How long raw messages are cached before being summarized and deleted.
# This is the number quoted to users in the privacy notice.
MESSAGE_RETENTION_HOURS=48

# How long generated summaries are kept.
SUMMARY_RETENTION_DAYS=14

# Max characters stored per message. Lower means a smaller database.
MESSAGE_MAX_CHARS=2000

# Your plan's database size cap, in MB (Supabase free tier is 500).
# Cleanup halves the retention window once usage passes 85% of this.
DATABASE_SOFT_LIMIT_MB=500
